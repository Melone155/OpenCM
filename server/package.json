{
  "name": "@opencm/server",
  "version": "0.8.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "dev:worker": "node --watch --env-file-if-exists=.env src/worker.ts",
    "start": "node src/index.ts",
    "start:worker": "node src/worker.ts",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@peculiar/x509": "^3.1.0",
    "bullmq": "^6.7.5",
    "cron-parser": "^5.10.4",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "hash-wasm": "^4.13.0",
    "ldapts": "^9.2.0",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "reflect-metadata": "^0.2.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^26.6.6",
    "typescript": "~5.9"
  }
}
