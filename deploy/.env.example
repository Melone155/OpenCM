# ---- OpenCM configuration (copy to .env, never commit .env) ----

# Public hostname. Caddy obtains a Let's Encrypt certificate for it automatically.
OPENCM_DOMAIN=cm.example.org
ACME_EMAIL=admin@example.org

# Image tag / registry (images are built locally by `docker compose build` if absent)
OPENCM_VERSION=latest
OPENCM_REGISTRY=opencm

# Database password – generate e.g. with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# First start only: created if no user exists yet. Remove afterwards.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Sessions & security
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
LOGIN_RATE_LIMIT_PER_MIN=10

LOG_LEVEL=info

# ---- Agents (M1)
# Agents connect via mTLS to this port (published directly by the server container).
AGENT_PORT_PUBLISHED=8443
# URL agents use for the mTLS endpoint. Default: https://<OPENCM_DOMAIN>:8443
AGENT_PUBLIC_URL=
# Additional DNS names / IPs for the agent endpoint certificate (comma separated)
AGENT_TLS_HOSTNAMES=
AGENT_HEARTBEAT_SECONDS=60

# ---- Scripts & jobs (M2)
# Offer newer agent binaries (from AGENT_DOWNLOAD_DIR + version.txt) to agents automatically
AGENT_AUTO_UPDATE=true
# Allow approving script versions you created yourself (false = second person required, recommended)
SCRIPT_SELF_APPROVAL=false
# Stored output per task (bytes)
TASK_OUTPUT_MAX_BYTES=1048576
TASK_TIMEOUT_GRACE_SECONDS=120

# ---- Vulnerabilities (M3)
VULN_FEEDS_ENABLED=true
# Free API key from https://nvd.nist.gov/developers/request-an-api-key – raises the
# NVD rate limit 10x (initial mirror: minutes instead of ~25-40 min; optional)
NVD_API_KEY=
NVD_SYNC_INTERVAL_HOURS=2
KEV_SYNC_INTERVAL_HOURS=6
EPSS_SYNC_INTERVAL_HOURS=24
# Webhook for new critical / actively exploited findings (signed: X-OpenCM-Signature: sha256=<HMAC>)
VULN_WEBHOOK_URL=
VULN_WEBHOOK_SECRET=
# Outbound proxy for the feeds (Node >= 24 honours these with NODE_USE_ENV_PROXY=1)
NODE_USE_ENV_PROXY=
HTTPS_PROXY=
NO_PROXY=postgres,redis,localhost

# ---- Permissions & login security (M4)
# Initial values only - afterwards changed in the web UI (System > Sicherheit) and stored in the DB.
# Four-eyes: mass actions (all devices or >= threshold devices) need approval by a second person
FOUR_EYES_ENABLED=true
FOUR_EYES_DEVICE_THRESHOLD=50
# Devices of a user's own runs within this many minutes count towards the threshold,
# so it cannot be undercut by several small runs (0 = every request on its own)
FOUR_EYES_WINDOW_MINUTES=60
# Require TOTP two-factor login for all users
MFA_REQUIRED=false
# Maximum lifetime of personal API tokens (days)
API_TOKEN_MAX_DAYS=365

# ---- LDAP / Active Directory (optional; enabled when LDAP_URL is set)
# ldaps://dc01.firma.local:636 (recommended) or ldap://... with LDAP_STARTTLS=true
LDAP_URL=
# Service account with read access (bind as DN or user@domain)
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
# {username} is replaced (RFC 4515 escaped)
LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={username}))
LDAP_USERNAME_ATTRIBUTE=sAMAccountName
LDAP_DISPLAYNAME_ATTRIBUTE=displayName
LDAP_EMAIL_ATTRIBUTE=mail
# Where to search groups (default: LDAP_BASE_DN); nested groups use the AD matching rule in chain
LDAP_GROUP_BASE_DN=
LDAP_NESTED_GROUPS=true
# true = only members of an AD group mapped to an OpenCM group may log in
LDAP_REQUIRE_GROUP=true
LDAP_STARTTLS=false
# CA certificate of the domain controllers, path inside the container (copy into the pki volume)
LDAP_CA_FILE=
LDAP_TLS_INSECURE=false
LDAP_TIMEOUT_MS=10000

# ---- Software distribution & patches (M5)
# Maximum size of an uploaded installer file (bytes, default 4 GiB)
PACKAGE_MAX_BYTES=4294967296
# Download bandwidth for installer files to agents in KiB/s (0 = unlimited): total and per device
PACKAGE_BANDWIDTH_KBPS=0
PACKAGE_BANDWIDTH_PER_DEVICE_KBPS=0
# Automatic patch scan of online devices every N hours (0 = off)
PATCH_SCAN_INTERVAL_HOURS=24

# ---- Reports, webhooks (M6)
# Webhook targets must use https:// - set true to allow plain http:// (e.g. internal test systems)
WEBHOOK_ALLOW_HTTP=false
WEBHOOK_TIMEOUT_MS=10000
# Daily metrics for dashboard trends are kept this many days
METRICS_RETENTION_DAYS=400

# ---- OSV, security status (M7)
# Check Linux distribution packages (Debian, Ubuntu, Rocky, AlmaLinux) against osv.dev.
# Only package names and versions are sent - never host names or addresses.
OSV_ENABLED=true
# OSV_API_URL=https://api.osv.dev
# Re-check each installed package version after N hours
OSV_SYNC_INTERVAL_HOURS=24
# Antivirus signatures older than N days count as outdated (macOS XProtect: at least 30)
SECURITY_AV_MAX_AGE_DAYS=3
