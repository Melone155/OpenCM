# Reverse proxy with automatic HTTPS (Let's Encrypt) for OPENCM_DOMAIN.
# For an internal CA / no public DNS, replace the site block's TLS with:
#   tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/key.pem   (and mount the files)
# or `tls internal` for Caddy's own CA.
#
# Note for M1: agent traffic uses mTLS with OpenCM's own CA and will be served on a
# dedicated port (TLS passthrough to the server), not through this site block.
{
	email {$ACME_EMAIL}
}

{$OPENCM_DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy server:8080
	}

	handle {
		reverse_proxy web:8080
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output stdout
		format json
	}
}
